PHISCATCHER_APP_NAME=Phiscatcher API
PHISCATCHER_ENVIRONMENT=development
PHISCATCHER_HOST=127.0.0.1
PHISCATCHER_PORT=8000
PHISCATCHER_FRONTEND_ORIGINS=http://localhost:5173
PHISCATCHER_ANALYSIS_TIMEOUT_SECONDS=300
PHISCATCHER_MAX_CONCURRENT_ANALYSES=2
PHISCATCHER_SESSION_RETENTION_SECONDS=3600
PHISCATCHER_LOG_LEVEL=INFO
PHISCATCHER_PCAP_OUTPUT_DIRECTORY=../packet-captures/raw
PHISCATCHER_WEBSOCKET_EVENT_HISTORY_LIMIT=50
